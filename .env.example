# Valores para rodar fora do profile `local` (que sobe o compose.yaml e preenche tudo sozinho).
# No cluster: ConfigMap/Secret preenchidos pelo pipeline; sem chave AWS (os pods usam a LabRole).

# MongoDB (replica set obrigatorio). Deploy: outputs mongodb_* e Secret do mechanical-hub-database
MONGODB_URI=mongodb://localhost:27017/mechanical_hub_orchestrator?replicaSet=rs0

# SQS. Deploy: outputs sqs_queue_urls / sqs_dlq_urls do mechanical-hub-infra
AWS_REGION=us-east-1
ORCHESTRATOR_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/mechanical-hub-orchestrator-events.fifo
ORCHESTRATOR_EVENTS_DLQ_URL=http://localhost:4566/000000000000/mechanical-hub-orchestrator-events-dlq.fifo
ORDERS_COMMANDS_QUEUE_URL=http://localhost:4566/000000000000/mechanical-hub-orders-commands.fifo
STOCK_COMMANDS_QUEUE_URL=http://localhost:4566/000000000000/mechanical-hub-stock-commands.fifo
BILLING_COMMANDS_QUEUE_URL=http://localhost:4566/000000000000/mechanical-hub-billing-commands.fifo

# Ambiente (rotulo de logs e metricas)
ENVIRONMENT=local

# OpenTelemetry. Deploy: output otlp_http_endpoint (sem coletor: none)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_EXPORTER=none
